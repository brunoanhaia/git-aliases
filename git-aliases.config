[alias]
	st = status -s
	ll = log --pretty=format:%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn] --decorate --numstat --date=short
	ch = checkout
	co = commit
	br = branch
	tree = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset%n' --abbrev-commit --date=relative --branches
	pr = pull --rebase
	ps = push
	sh = show
	fe = fetch
	di = diff
	undo = reset --soft HEAD~1
	hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
	hr = reset --hard "@{u}"
